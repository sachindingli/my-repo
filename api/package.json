{
  "name": "hitkram-api",
  "version": "1.0.0",
  "private": true,
  "description": "Hitkram store API (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 test/*.test.js",
    "pretest": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy && node --env-file=.env.test prisma/seed.js --overwrite"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.1"
  }
}

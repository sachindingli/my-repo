# PostgreSQL connection strings. On Vercel + Neon both are added automatically.
# Locally, set both to the same value.
DATABASE_URL=postgresql://hitkram:password@localhost:5432/hitkram
DATABASE_URL_UNPOOLED=postgresql://hitkram:password@localhost:5432/hitkram
PORT=4000

# Storefront address(es) allowed to call the API (comma-separated)
WEB_ORIGIN=http://localhost:3000

# Long random string (at least 32 characters in production)
JWT_SECRET=

# First admin account, created by `npm run db:seed` if it doesn't exist yet
ADMIN_EMAIL=admin@hitkram.com
ADMIN_PASSWORD=

# Shipping: fee in ₹ below the free-shipping threshold
SHIPPING_FEE=80
FREE_SHIPPING_MIN=1000
COD_ENABLED=true

# Razorpay (leave empty to offer Cash on Delivery only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Vercel Blob token for admin photo uploads (added automatically when you connect Blob storage).
# Without it, uploads are saved to UPLOAD_DIR (default ./uploads), which only works on a normal server.
# BLOB_READ_WRITE_TOKEN=

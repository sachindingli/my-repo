# Vote storage for the Deengli Sarpanch poll.
#
# Leave these empty for local development (`npm run dev`) — votes are then saved
# to a local file at .data/votes.json.
#
# For the shared, public site you MUST set a REST database, or votes will not
# persist / will not be shared between voters. Create a free database at
# https://upstash.com (Redis) or add Vercel KV in the Vercel dashboard, then
# paste the REST URL + token here (or into your host's Environment Variables).

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ...or Vercel KV (either pair works)
KV_REST_API_URL=
KV_REST_API_TOKEN=
